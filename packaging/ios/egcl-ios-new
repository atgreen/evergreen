"""Generate an arm64 Xcode application embedding the EGCL iOS worker runtime."""
import argparse
import json
from pathlib import Path
import re
import plistlib
import shutil
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('directory', type=Path)
    parser.add_argument('--bundle-id', default='org.example.lispapp')
    parser.add_argument('--name', default='Lisp App', help='Application display name')
    parser.add_argument('--team', default='', help='Apple development team ID')
    parser.add_argument('--runtime-source', type=Path, default=Path(__file__).resolve().parents[2])
    args = parser.parse_args()
    if not re.fullmatch(r'[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+', args.bundle_id):
        parser.error('--bundle-id must be a dotted application identifier')
    if args.team and not re.fullmatch(r'[A-Z0-9]{10}', args.team):
        parser.error('--team must be the ten-character Apple development team ID')
    if (not args.name or any(ord(char) < 32 for char in args.name)
            or any(char in args.name for char in '$#') or '//' in args.name):
        parser.error('--name must be nonempty without control characters, $, # or //')
    if args.directory.exists():
        parser.error(f'refusing to overwrite existing destination: {args.directory}')
    source = args.runtime_source.resolve()
    template = Path(__file__).resolve().parent / 'templates'
    inputs = {
        'LispApp.swift': source / 'examples/ios/EGCLIOSDemo.swift',
        'LispApp-Bridging-Header.h': source / 'examples/ios/EGCLIOSDemo-Bridging-Header.h',
        'egcl_ios.h': source / 'crates/egcl-ios/include/egcl_ios.h',
        'Lisp/app.lisp': source / 'examples/ios/Lisp/app.lisp',
        'BuildRuntime.py': template / 'BuildRuntime.py',
    }
    if not (source / 'crates/egcl-ios/Cargo.toml').is_file():
        parser.error('--runtime-source must contain the egcl-ios runtime crate')
    for path in inputs.values():
        if not path.is_file():
            parser.error(f'missing source template: {path}')
    project = (template / 'project.pbxproj').read_text()
    settings = (template / 'Project.xcconfig').read_text()
    # Only validated bundle/team identifiers enter Xcode configuration text.
    # Paths use a JSON file; the display name uses XML plist escaping.
    replacements = {
        'BUNDLE_ID': args.bundle_id,
        'TEAM': args.team,
    }
    settings = re.sub(r'@(BUNDLE_ID|TEAM)@',
                      lambda match: replacements[match[1]], settings)
    args.directory.mkdir(parents=True)
    for destination, path in inputs.items():
        output = args.directory / destination
        output.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, output)
    xcode = args.directory / 'LispApp.xcodeproj'
    schemes = xcode / 'xcshareddata/xcschemes'
    schemes.mkdir(parents=True)
    (xcode / 'project.pbxproj').write_text(project)
    shutil.copy2(template / 'LispApp.xcscheme', schemes / 'LispApp.xcscheme')
    (args.directory / 'Project.xcconfig').write_text(settings)
    (args.directory / 'RuntimeSource.json').write_text(
        json.dumps({'version': 1, 'runtime_source': str(source)},
                   indent=2, ensure_ascii=False) + '\n', encoding='utf-8')
    with (args.directory / 'Info.plist').open('wb') as output:
        plistlib.dump({
            'CFBundleDisplayName': args.name,
            'CFBundleExecutable': '$(EXECUTABLE_NAME)',
            'CFBundleIdentifier': '$(PRODUCT_BUNDLE_IDENTIFIER)',
            'CFBundleInfoDictionaryVersion': '6.0',
            'CFBundleName': '$(PRODUCT_NAME)',
            'CFBundlePackageType': 'APPL',
            'CFBundleShortVersionString': '1.0',
            'CFBundleVersion': '1',
            'LSRequiresIPhoneOS': True,
            'UIApplicationSceneManifest': {
                'UIApplicationSupportsMultipleScenes': True,
                'UISceneConfigurations': {},
            },
            'UILaunchScreen': {},
            'UISupportedInterfaceOrientations': [
                'UIInterfaceOrientationPortrait',
                'UIInterfaceOrientationPortraitUpsideDown',
                'UIInterfaceOrientationLandscapeLeft',
                'UIInterfaceOrientationLandscapeRight',
            ],
        }, output)
    (args.directory / '.gitignore').write_text('build/\nDerivedData/\nxcuserdata/\nRuntimeSource.json\n')
    shutil.copy2(template / 'README.md', args.directory / 'README.md')
    print(f'Created {xcode}; select signing team and an arm64 device/simulator in Xcode.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError) as error:
        sys.exit(f'egcl-ios-new: {error}')
