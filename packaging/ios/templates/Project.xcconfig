PRODUCT_BUNDLE_IDENTIFIER = @BUNDLE_ID@
DEVELOPMENT_TEAM = @TEAM@
PRODUCT_NAME = LispApp
SWIFT_VERSION = 5.0
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
ARCHS = arm64
TARGETED_DEVICE_FAMILY = 1,2
SDKROOT = iphoneos
CODE_SIGN_STYLE = Automatic
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = $(SRCROOT)/Info.plist
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/LispApp-Bridging-Header.h
HEADER_SEARCH_PATHS = $(inherited) "$(SRCROOT)"
LIBRARY_SEARCH_PATHS = $(inherited) "$(BUILT_PRODUCTS_DIR)"
OTHER_LDFLAGS = $(inherited) -legcl_ios @"$(DERIVED_FILE_DIR)/egcl-native-libs.rsp"
ENABLE_USER_SCRIPT_SANDBOXING = NO
