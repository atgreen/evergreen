#!/usr/bin/bash
# The target is selected by the installed command name; arguments pass unchanged.
set -euo pipefail
target=${0##*/}
target=${target#torcl-}
root=${TORCL_CROSS_ROOT:-/usr/libexec/torcl}
directory=$root/$target
runtime=$directory/torcl
case "$target" in
    s390x-linux) runner=(qemu-s390x -L "$directory/sysroot") ;;
    aarch64-linux) runner=(qemu-aarch64 -L "$directory/sysroot") ;;
    android) runner=(qemu-aarch64) ;;
    windows)
        runner=(wine)
        runtime=$directory/torcl.exe
        export WINEPREFIX=${WINEPREFIX:-${XDG_DATA_HOME:-$HOME/.local/share}/torcl/wine}
        export WINEDEBUG=${WINEDEBUG:--all}
        mkdir -p "$WINEPREFIX"
        ;;
    *) echo "Unknown TorCL cross target: $target" >&2; exit 2 ;;
esac
if [[ ! -f "$runtime" ]]; then
    echo "Missing TorCL runtime: $runtime; reinstall torcl-target-$target." >&2
    exit 1
fi
if ! command -v "${runner[0]}" >/dev/null; then
    echo "Missing ${runner[0]}; install the runtime dependencies of torcl-target-$target." >&2
    exit 1
fi
exec "${runner[@]}" "$runtime" "$@"
