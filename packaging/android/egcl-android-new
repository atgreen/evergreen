#!/usr/bin/python3
"""Create a Makefile-based EGCL Android application."""
import argparse
import json
import os
from pathlib import Path
import re
import shutil
import sys
import xml.etree.ElementTree as ET

HOSTS = ('aarch64-linux-android', 'x86_64-linux-android')
ANDROID = 'http://schemas.android.com/apk/res/android'
ET.register_namespace('android', ANDROID)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('directory', type=Path)
    parser.add_argument('--host', choices=HOSTS, default=HOSTS[0])
    parser.add_argument('--package', default='org.example.hello')
    parser.add_argument('--name', help='Display name (defaults to directory name)')
    parser.add_argument('--template', choices=('egl', 'minimal'), default='egl')
    parser.add_argument('--runtime', type=Path, default=Path(os.environ.get('EGCL_ANDROID_RUNTIME', '/usr/libexec/egcl/android')))
    args = parser.parse_args()
    if not re.fullmatch(r'[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+', args.package):
        parser.error('--package must be a dotted Android package name, for example org.example.hello')
    if args.directory.exists():
        parser.error(f'refusing to overwrite existing directory: {args.directory}')
    runtime_path = str(args.runtime.resolve())
    if any(c in runtime_path for c in '\n\r$#'):
        parser.error('runtime path cannot contain newline, $, or #')
    # Installed templates live with the runtime; source-tree use is supported for tests.
    source = Path(__file__).resolve().parent
    templates = args.runtime / 'templates'
    if not templates.is_dir():
        templates = source / 'templates'
    if not templates.is_dir():
        parser.error(f'missing templates: install egcl-target-android or set --runtime')
    version = 'source'
    metadata = args.runtime / 'runtime.json'
    if metadata.exists():
        version = json.loads(metadata.read_text())['version']
    args.directory.mkdir(parents=True)
    assets = args.directory / 'assets'
    assets.mkdir()
    for name in ('android.lisp', 'egl.lisp'):
        shutil.copy2(templates / name, assets / name)
    shutil.copy2(templates / ('egl-app.lisp' if args.template == 'egl' else 'minimal.lisp'), assets / 'app.lisp')
    for name in ('Makefile', 'README.md', '.gitignore'):
        text = (templates / name).read_text().replace('@HOST@', args.host)
        (args.directory / name).write_text(text)
    (args.directory / 'app.json').write_text(json.dumps({
        'host': args.host, 'package': args.package, 'name': args.name or args.directory.name,
        # Matches build-runtime.py's metadata and egcl_android_api_version.
        # build-apk.py refuses to package a project whose runtime_api differs.
        'runtime_api': 4, 'runtime_version': version,
    }, indent=2) + '\n')
    if args.runtime != Path('/usr/libexec/egcl/android'):
        # Keep machine-specific runtime locations out of the generated source.
        (args.directory / 'local.mk').write_text(f'RUNTIME := {runtime_path}\n')
    def attrs(**values): return {f'{{{ANDROID}}}{k}': str(v) for k, v in values.items()}
    manifest = ET.Element('manifest', {'package': args.package, **attrs(versionCode=1, versionName='0.1')})
    ET.SubElement(manifest, 'uses-sdk', attrs(minSdkVersion=28, targetSdkVersion=34))
    if args.template == 'egl':
        ET.SubElement(manifest, 'uses-feature', attrs(glEsVersion='0x00020000', required='true'))
    application = ET.SubElement(manifest, 'application', attrs(label=args.name or args.directory.name,
        hasCode='false', extractNativeLibs='true', debuggable='true',
        theme='@android:style/Theme.Material.NoActionBar.Fullscreen'))
    activity = ET.SubElement(application, 'activity', attrs(name='android.app.NativeActivity',
        exported='true', launchMode='singleTask', configChanges='orientation|screenSize|keyboardHidden'))
    ET.SubElement(activity, 'meta-data', attrs(name='android.app.lib_name', value='egcl_android'))
    intent = ET.SubElement(activity, 'intent-filter')
    ET.SubElement(intent, 'action', attrs(name='android.intent.action.MAIN'))
    ET.SubElement(intent, 'category', attrs(name='android.intent.category.LAUNCHER'))
    ET.indent(manifest)
    ET.ElementTree(manifest).write(args.directory / 'AndroidManifest.xml', encoding='utf-8', xml_declaration=True)
    print(f'Created {args.directory} ({args.host}, {args.template}). Run make -C {args.directory}')


if __name__ == '__main__':
    try: main()
    except (OSError, ValueError, KeyError) as error:
        sys.exit(f'egcl-android-new: {error}')
