(defgeneric binding-gf (x))
(defmethod binding-gf ((x integer)) (+ x 1))
(defparameter *binding-saved* #'binding-gf)
(defun binding-call (x) (binding-gf x))
(defun binding-symbol-call (x) (funcall 'binding-gf x))
(dotimes (i 40) (assert (= (binding-call 1) 2)))
(setf (symbol-function 'binding-gf) (lambda (x) (+ x 100)))
(assert (fboundp 'binding-gf))
(assert (= (binding-call 1) 101))
(assert (= (binding-symbol-call 1) 101))
(assert (= (funcall *binding-saved* 1) 2))
(fmakunbound 'binding-gf)
(assert (not (fboundp 'binding-gf)))
(assert (handler-case (progn (binding-call 1) nil) (undefined-function (condition) (equal (cell-error-name condition) 'binding-gf))))
(assert (handler-case (progn (binding-symbol-call 1) nil) (undefined-function (condition) (equal (cell-error-name condition) 'binding-gf))))
(assert (handler-case (progn (fdefinition 'binding-gf) nil) (undefined-function (condition) (equal (cell-error-name condition) 'binding-gf))))
(assert (= (funcall *binding-saved* 1) 2))
(setf (symbol-function 'binding-gf) *binding-saved*)
(assert (fboundp 'binding-gf))
(assert (= (binding-call 1) 2))

(defgeneric (setf binding-value) (new object))
(defmethod (setf binding-value) (new (object cons)) (setf (car object) new) new)
(defparameter *binding-saved-writer* #'(setf binding-value))
(defparameter *binding-object* (list 0))
(defun binding-write (object) (setf (binding-value object) 7))
(dotimes (i 40) (assert (= (binding-write *binding-object*) 7)))
(setf (fdefinition '(setf binding-value))
      (lambda (new object) (setf (car object) (+ new 100)) new))
(assert (fboundp '(setf binding-value)))
(assert (= (binding-write *binding-object*) 7))
(assert (= (car *binding-object*) 107))
(assert (= (funcall *binding-saved-writer* 3 *binding-object*) 3))
(assert (= (car *binding-object*) 3))
(fmakunbound '(setf binding-value))
(assert (not (fboundp '(setf binding-value))))
(assert (handler-case (progn (binding-write *binding-object*) nil) (undefined-function (condition) (equal (cell-error-name condition) '(setf binding-value)))))
(assert (handler-case (progn (fdefinition '(setf binding-value)) nil) (undefined-function (condition) (equal (cell-error-name condition) '(setf binding-value)))))
(assert (= (funcall *binding-saved-writer* 4 *binding-object*) 4))
(setf (fdefinition '(setf binding-value)) *binding-saved-writer*)
(assert (fboundp '(setf binding-value)))
(assert (= (binding-write *binding-object*) 7))
(assert (= (car *binding-object*) 7))
(format t "GENERIC-BINDINGS-OK~%")
