(in-package :cl-user)
(defclass pprint-sink (egcl-gray-streams:fundamental-character-output-stream)
  ((output :initform (make-string-output-stream) :reader pprint-sink-output)))
(defmethod egcl-gray-streams:stream-write-char ((s pprint-sink) c)
  (write-char c (pprint-sink-output s)))
(defmethod egcl-gray-streams:stream-line-column ((s pprint-sink)) 5)
(let ((s (make-instance 'pprint-sink))
      (*print-pretty* t) (*print-right-margin* 10) (*print-miser-width* nil))
  (pprint-fill s '(111 222))
  (assert (string= (format nil "(111~%      222)")
                   (get-output-stream-string (pprint-sink-output s)))))
(format t "PPRINT-GRAY-OK~%")
