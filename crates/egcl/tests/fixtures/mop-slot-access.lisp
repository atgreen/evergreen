(defclass access-meta (standard-class) ())
(defmethod egcl-mop:validate-superclass ((c access-meta) (s standard-class)) t)
(defclass access-slot (egcl-mop:standard-effective-slot-definition) ())
(defparameter *access-name-calls* 0)
(defmethod egcl-mop:effective-slot-definition-class ((class access-meta) &rest args)
  (declare (ignore class args))
  (find-class 'access-slot))
(defmethod egcl-mop:slot-definition-name :around ((slot access-slot))
  (incf *access-name-calls*)
  (call-next-method))
(defclass access-probe ()
  ((value :initform 7 :accessor access-value)
   (shared :initform 9 :allocation :class))
  (:metaclass access-meta))
(defclass access-child (access-probe) () (:metaclass access-meta))
(defparameter *access-events* nil)
(defparameter *access-definition* nil)

(defmethod egcl-mop:slot-value-using-class :around
    ((class access-meta) (object access-probe) slot)
  (assert (eq class (class-of object)))
  (when (eq (egcl-mop:slot-definition-name slot) 'value)
    (assert (member slot (egcl-mop:class-slots class) :test #'eq))
    (setq *access-definition* slot)
    (push :read *access-events*))
  (call-next-method))
(defmethod (setf egcl-mop:slot-value-using-class) :around
    (new (class access-meta) (object access-probe) slot)
  (push :write *access-events*)
  (call-next-method new class object slot))
(defmethod egcl-mop:slot-boundp-using-class :around
    ((class access-meta) (object access-probe) slot)
  (push :boundp *access-events*)
  (call-next-method))
(defmethod egcl-mop:slot-makunbound-using-class :around
    ((class access-meta) (object access-probe) slot)
  (push :makunbound *access-events*)
  (call-next-method))

(defmethod slot-unbound (class (object access-probe) (name (eql 'value)))
  (assert (eq class (class-of object)))
  (push :unbound *access-events*)
  (values 81 82))
(defmethod slot-missing (class (object access-probe) (name (eql 'absent)) operation
                        &optional new)
  (declare (ignore class object name operation new))
  (push :missing *access-events*)
  (values 83 84))

(defun check-access-protocol ()
  (let ((object (make-instance 'access-child)))
    (setq *access-events* nil)
    (assert (= (access-value object) 7))
    (assert (equal *access-events* '(:read)))
    (let ((definition *access-definition*))
      (assert (= (slot-value object 'value) 7))
      (assert (eq definition *access-definition*)))
    (assert (= (setf (access-value object) 31) 31))
    (assert (= (slot-value object 'value) 31))
    ;; The writer callback allocates its event list with a fresh Lisp value live.
    (assert (equal (setf (access-value object) (list 33 34)) '(33 34)))
    (assert (equal (slot-value object 'value) '(33 34)))
    (assert (slot-boundp object 'value))
    (assert (eq object (slot-makunbound object 'value)))
    (assert (not (slot-boundp object 'value)))
    (assert (equal (multiple-value-list (access-value object)) '(81)))
    (assert (equal (multiple-value-list (slot-value object 'absent)) '(83)))
    (assert (= (setf (slot-value object 'absent) 45) 45))
    (assert (= (setf (slot-value object 'shared) 61) 61))
    (assert (= (slot-value (make-instance 'access-probe) 'shared) 61))
    (assert (eq object (slot-makunbound object 'shared)))
    (assert (not (slot-boundp object 'shared)))
    (dolist (event '(:read :write :boundp :makunbound :unbound :missing))
      (assert (member event *access-events*)))))
;; Structures keep their established storage and accessor behavior.
(defstruct access-structure (value 5))
(let ((object (make-access-structure)))
  (assert (= (access-structure-value object) 5))
  (assert (= (setf (access-structure-value object) 6) 6)))
(check-access-protocol)
(assert (plusp *access-name-calls*))
(format t "MOP-SLOT-ACCESS-OK~%")
