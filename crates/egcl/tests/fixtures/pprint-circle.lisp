(in-package :cl-user)
(let ((*print-circle* t) (cycle (list nil)))
  (setf (car cycle) cycle)
  (dolist (root '(nil (1)))
    (let* ((text (with-output-to-string (s)
                   (pprint-logical-block (s root) (write cycle :stream s))))
           (copy (read-from-string text)))
      (assert (eq copy (car copy))))))
(let ((*print-circle* t) (outer (list 1)) (inner (list nil)))
  (setf (cdr outer) outer (car inner) inner)
  (let* ((text (with-output-to-string (s)
                 (pprint-logical-block (s outer :prefix "(" :suffix ")")
                   (write inner :stream s)
                   (write-string " . " s)
                   (write outer :stream s))))
         (copy (read-from-string text)))
    (assert (search "#2=" text))
    (assert (eq copy (cdr copy)))
    (assert (eq (car copy) (caar copy)))
    (assert (not (eq copy (car copy))))))
(let ((*print-circle* t) (first (list nil)) (second (list nil)))
  (setf (car first) first (car second) second)
  (let ((text (with-output-to-string (s)
                (pprint-logical-block (s nil :prefix "(" :suffix ")")
                  (write first :stream s) (write-char #\Space s)
                  (write second :stream s)))))
    (assert (search "#1=" text))
    (assert (search "#2=" text))))
(format t "PPRINT-CIRCLE-OK~%")
