;; Bootstrap must publish its public APIs before qualified definitions are read.
;; Check package status before READ-FROM-STRING can affect symbol lookup.
(dolist (spec '(("EGCL-THREAD" "MAKE-MUTEX" "WITH-MUTEX"
                 "MAKE-CONDITION-VARIABLE" "CONDITION-VARIABLE-P")
                ("EGCL-CLTL2" "DEFINE-DECLARATION" "DECLARATION-INFORMATION")
                ("EGCL-PYTHON" "EXEC" "EXCEPTION")
                ("EGCL-EXT" "FUNCTION-TIER" "GC" "PROCLAIMED-OPTIMIZE"
                 "DECLARATION-SPECIFIERS" "WITH-LOCKED-HASH-TABLE" "GETENV")))
  (dolist (name (cdr spec))
    (multiple-value-bind (symbol status) (find-symbol name (car spec))
      (assert (eq status :external))
      (assert (eq symbol (read-from-string
                         (concatenate 'string (car spec) ":" name)))))))
(let ((mutex (egcl-thread:make-mutex :name "reader-startup-regression"))
      (condition (egcl-thread:make-condition-variable)))
  (assert (egcl-thread:mutex-p mutex))
  (assert (egcl-thread:condition-variable-p condition))
  (assert (eq :locked (egcl-thread:with-mutex (mutex) :locked))))
(assert (null (egcl-ext:getenv "GH763-NO-SUCH-ENVIRONMENT-VARIABLE")))

(let* ((target (make-package "GH763-TARGET" :nicknames '("GH763-NICK")
                             :use '("COMMON-LISP")))
       (private (intern "PRIVATE" target))
       (public (intern "PUBLIC" target))
       (mixed (intern "Mi:XeD" target)))
  (export (list public mixed) target)
  (flet ((reject (token)
           (assert (handler-case (progn (read-from-string token) nil)
                     (reader-error (condition)
                       (and (typep condition 'stream-error)
                            (streamp (stream-error-stream condition))))))))
    ;; Neither a missing name nor a present internal/inherited name is public.
    (reject "GH763-TARGET:MISSING")
    (assert (null (find-symbol "MISSING" target)))
    (reject "GH763-TARGET:PRIVATE")
    (assert (equal (multiple-value-list (find-symbol "PRIVATE" target))
                   (list private :internal)))
    (reject "GH763-TARGET:CAR")
    (assert (equal (multiple-value-list (find-symbol "CAR" target))
                   (list 'car :inherited)))
    (reject "CL:NO-SUCH-THING-GH763")
    (assert (null (find-symbol "NO-SUCH-THING-GH763" "COMMON-LISP")))
    (reject "EGCL-MOP:NO-SUCH-THING-GH763")
    (assert (null (find-symbol "NO-SUCH-THING-GH763" "EGCL-MOP")))
    (reject "EGCL-EXT:NO-SUCH-THING-GH763")
    (assert (null (find-symbol "NO-SUCH-THING-GH763" "EGCL-EXT")))
    (reject "EGCL-THREAD:NO-SUCH-THING-GH763")
    (assert (null (find-symbol "NO-SUCH-THING-GH763" "EGCL-THREAD")))
    ;; Error classification must not mistake names containing EOF for EOF.
    (reject "GH763-TARGET:NO-EOF-SUCH-THING")
    (assert (null (find-symbol "NO-EOF-SUCH-THING" target)))
    (reject "GH763-NO-EOF-PACKAGE:NAME")
    (assert (null (find-package "GH763-NO-EOF-PACKAGE")))
    ;; Lookup respects case, literal colons, global nicknames and re-exports.
    (assert (eq public (read-from-string "GH763-TARGET:PUBLIC")))
    (assert (eq public (read-from-string "GH763-NICK:PUBLIC")))
    (assert (eq mixed (read-from-string "GH763-TARGET:|Mi:XeD|")))
    (reject "GH763-TARGET:|MI:XED|")
    (let ((lower (intern "lower" target)))
      (export lower target)
      (dolist (spec '((:downcase "|GH763-TARGET|:LOWER")
                      (:preserve "|GH763-TARGET|:lower")
                      (:invert "|GH763-TARGET|:LOWER")))
        (let ((*readtable* (copy-readtable nil)))
          (setf (readtable-case *readtable*) (first spec))
          (assert (eq lower (read-from-string (second spec))))
          (assert (eq mixed (read-from-string "|GH763-TARGET|:|Mi:XeD|")))
          (reject "|GH763-TARGET|:|PRIVATE|"))))
    (import 'car target)
    (export 'car target)
    (assert (eq 'car (read-from-string "GH763-TARGET:CAR")))
    (assert (null (read-from-string "CL:NIL")))
    (assert (eq t (read-from-string "COMMON-LISP:T")))
    ;; Unexporting takes effect immediately; double-colon access still works.
    (unexport public target)
    (reject "GH763-TARGET:PUBLIC")
    (assert (eq public (read-from-string "GH763-TARGET::PUBLIC")))
    (assert (eq (read-from-string "GH763-TARGET::NEW-INTERNAL")
                (find-symbol "NEW-INTERNAL" target)))
    (assert (eq :internal (nth-value 1 (find-symbol "NEW-INTERNAL" target))))
    (assert (null (symbol-package (read-from-string "#:GH763-FRESH"))))
    (assert (string= "GH763-TARGET:PRIVATE"
                     (symbol-name (read-from-string "|GH763-TARGET:PRIVATE|"))))
    ;; Local nicknames use the target package's export table.
    (export public target)
    (let ((user (make-package "GH763-USER" :use '("COMMON-LISP"))))
      (egcl-ext:add-package-local-nickname "G763" target user)
      (egcl-ext:add-package-local-nickname "K763" :keyword user)
      (let ((*package* user))
        (assert (eq public (read-from-string "G763:PUBLIC")))
        (reject "G763:PRIVATE")
        (assert (keywordp (read-from-string "K763:GH763-KEYWORD")))))
    ;; Keywords keep their interning behavior; suppression never resolves names.
    (assert (null (find-symbol "GH763-NEW-KEYWORD" "KEYWORD")))
    (assert (keywordp (read-from-string "KEYWORD:GH763-NEW-KEYWORD")))
    (let ((*read-suppress* t))
      (assert (null (read-from-string "GH763-TARGET:SUPPRESSED")))
      (assert (null (read-from-string "GH763-NO-SUPPRESSED-PACKAGE:NAME"))))
    (assert (null (find-symbol "SUPPRESSED" target)))
    (assert (null (find-package "GH763-NO-SUPPRESSED-PACKAGE")))
    ;; Source LOAD uses the same check and leaves its missing name uninterned.
    (assert (handler-case (progn (load "@REJECT-FILE@") nil)
              (reader-error () t)))
    (assert (null (find-symbol "FROM-FILE" target)))))
(format t "READER-EXTERNAL-SYMBOLS-OK~%")
