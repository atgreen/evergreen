(let ((value '#1=#(#1#)))
  (assert (eq value (aref value 0))))
(let ((value (read-from-string "#1=#(#1#)")))
  (assert (eq value (aref value 0))))
(let ((value (eval (read-from-string "'#1=#(#1#)"))))
  (assert (eq value (aref value 0))))
(let ((value '#1=#(#1# #1# #1# #1#)))
  (dotimes (i 4) (assert (eq value (aref value i)))))
(let ((value '#1=#(#2=#(#1#) #2#)))
  (assert (eq (aref value 0) (aref value 1)))
  (assert (eq value (aref (aref value 0) 0))))
(let ((value '#1=#((#1#) #2=(a . #2#))))
  (assert (eq value (car (aref value 0))))
  (assert (eq (aref value 1) (cdr (aref value 1)))))
(let ((value '#1=(#(#1#) . #1#)))
  (assert (eq value (aref (car value) 0)))
  (assert (eq value (cdr value))))
(let ((value '#1=#2A((#1#))))
  (assert (eq value (aref value 0 0))))
(defstruct reader-label-node next)
(let ((value '#1=#S(reader-label-node :next #1#)))
  (assert (eq value (reader-label-node-next value))))
(format t "READER-VECTOR-LABELS-OK~%")
