(defparameter *lifecycle-old-symbols* nil)
(dotimes (round 6)
  (let* ((package (make-package "LIFECYCLE-REUSED" :use nil))
         (symbol (if (oddp round)
                     (progn (shadow "FOO" package) (find-symbol "FOO" package))
                     (intern "FOO" package))))
    (assert (not (member symbol *lifecycle-old-symbols* :test #'eq)))
    (assert (eq (symbol-package symbol) package))
    (assert (not (boundp symbol)))
    (assert (not (fboundp symbol)))
    (setf (symbol-value symbol) round)
    (setf (symbol-function symbol) (lambda () 99))
    (setf (get symbol 'lifecycle-property) round)
    (assert (string= (symbol-name symbol) "FOO"))
    (push symbol *lifecycle-old-symbols*)
    (when (evenp round)
      (assert (unintern symbol package))
      (assert (null (symbol-package symbol)))
      (let ((replacement (intern "FOO" package)))
        (assert (not (eq replacement symbol)))
        (assert (eq (symbol-package replacement) package))))
    (assert (delete-package package))
    (assert (null (package-name package)))
    (assert (null (find-package "LIFECYCLE-REUSED")))
    (assert (null (symbol-package symbol)))
    (assert (string= (prin1-to-string symbol) "#:FOO"))
    (assert (null (find-package "LIFECYCLE-REUSED")))
    (assert (= (symbol-value symbol) round))
    (assert (= (funcall symbol) 99))
    (assert (= (get symbol 'lifecycle-property) round))
    (assert (string= (symbol-name symbol) "FOO"))))
;; Removing an imported symbol must preserve the actual owner's identity/home.
(let* ((owner (make-package "LIFECYCLE-OWNER" :use nil))
       (target (make-package "LIFECYCLE-TARGET" :use nil))
       (symbol (intern "SHARED" owner)))
  (import symbol target)
  (assert (unintern symbol target))
  (assert (eq (symbol-package symbol) owner))
  (assert (eq (intern "SHARED" owner) symbol))
  (import symbol target)
  (delete-package target)
  (assert (eq (symbol-package symbol) owner))
  (let ((replacement (make-package "LIFECYCLE-TARGET" :use nil)))
    (assert (not (eq (intern "SHARED" replacement) symbol)))
    (delete-package replacement))
  (delete-package owner)
  (assert (null (symbol-package symbol)))
  (assert (null (find-package "LIFECYCLE-OWNER"))))
;; Explicitly importing an old homeless symbol is allowed to give it a new home.
(let* ((old (make-package "LIFECYCLE-IMPORT-OLD" :use nil))
       (new (make-package "LIFECYCLE-IMPORT-NEW" :use nil))
       (symbol (intern "FOO" old)))
  (unintern symbol old)
  (import symbol new)
  (assert (eq (symbol-package symbol) new))
  (assert (eq (find-symbol "FOO" new) symbol))
  (delete-package old)
  (assert (eq (symbol-package symbol) new))
  (delete-package new)
  (assert (null (symbol-package symbol))))
;; Deletion follows object identity after renaming, including nickname removal.
(let* ((package (make-package "LIFECYCLE-NAMED" :nicknames '("LIFECYCLE-NICK") :use nil))
       (symbol (intern "BAR" package)))
  (rename-package package "LIFECYCLE-RENAMED" '("LIFECYCLE-NICK2"))
  (delete-package package)
  (assert (null (symbol-package symbol)))
  (dolist (name '("LIFECYCLE-NAMED" "LIFECYCLE-NICK" "LIFECYCLE-RENAMED" "LIFECYCLE-NICK2"))
    (assert (null (find-package name)))))
(write-line "PACKAGE-LIFECYCLE-OK")
