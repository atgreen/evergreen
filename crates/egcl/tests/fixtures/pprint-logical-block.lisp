(in-package :cl-user)

(defun logical-list (stream object)
  (pprint-logical-block (stream object :prefix "(" :suffix ")")
    (pprint-exit-if-list-exhausted)
    (loop
      (write (pprint-pop) :stream stream)
      (pprint-exit-if-list-exhausted)
      (write-char #\Space stream)
      (pprint-newline :fill stream))))

(defun check-logical-blocks ()
  (assert (macro-function 'pprint-logical-block))
  (let ((*print-escape* nil))
    (assert (string= "alpha" (with-output-to-string (s) (write "alpha" :stream s)))))
  (assert (string= "(1 2 3)" (with-output-to-string (s) (logical-list s '(1 2 3)))))
  (assert (string= "()" (with-output-to-string (s) (logical-list s nil))))
  (assert (string= "17" (with-output-to-string (s) (logical-list s 17))))
  (assert (string= "(1 2 . 3)" (with-output-to-string (s) (logical-list s '(1 2 . 3)))))
  (let ((*print-length* 2))
    (assert (string= "(1 2 ...)" (with-output-to-string (s) (logical-list s '(1 2 3))))))
  (let ((*print-level* 0))
    (assert (string= "#" (with-output-to-string (s) (logical-list s '(1 2))))))
  (let ((*print-level* 1))
    (assert (string= "(#)" (with-output-to-string (s) (logical-list s '((1 2)))))))
  (let ((*print-circle* t) (cycle (list 1 2)))
    (setf (cddr cycle) cycle)
    (let* ((text (with-output-to-string (s) (logical-list s cycle)))
           (copy (read-from-string text)))
      (assert (search "#1#" text))
      (assert (equal '(1 2 1 2 1 2) (loop repeat 6 collect (pop copy))))))
  (assert (string= "[1(3 4)2]"
                   (with-output-to-string (s)
                     (pprint-logical-block (s '(1 2) :prefix "[" :suffix "]")
                       (write (pprint-pop) :stream s)
                       (logical-list s '(3 4))
                       (write (pprint-pop) :stream s)))))
  (assert (string= (format nil ";; a~%;; b!")
                   (with-output-to-string (s)
                     (pprint-logical-block (s nil :per-line-prefix ";; " :suffix "!")
                       (write-string "a" s) (terpri s) (write-string "b" s)))))
  (assert (string= (format nil "(a~%b)")
                   (with-output-to-string (s)
                     (pprint-logical-block (s nil :prefix "(" :suffix ")")
                       (write-string "a" s) (terpri s) (write-string "b" s)))))
  (let ((*print-pretty* t) (*print-right-margin* 8) (*print-miser-width* nil))
    (assert (string= (format nil "(111~% 222~% 333)")
                     (with-output-to-string (s) (logical-list s '(111 222 333))))))
  (let ((*print-pretty* nil) (*print-right-margin* 3))
    (assert (string= "(111 222)" (with-output-to-string (s) (logical-list s '(111 222))))))
  (assert (string= "[... ]"
                   (with-output-to-string (s)
                     (let ((*print-length* 0))
                       (pprint-logical-block (s nil :prefix "[" :suffix " ]")
                         (pprint-pop) (write-string "bad" s))))))
  (assert (string= "[]"
                   (with-output-to-string (s)
                     (pprint-logical-block (s nil :prefix "[" :suffix "]")
                       (pprint-exit-if-list-exhausted) (write-string "bad" s)))))
  (let ((s (make-string-output-stream)))
    (assert (equal '(nil) (multiple-value-list (pprint-logical-block (s nil) (values 1 2)))))
    (let ((*standard-output* s))
      (pprint-logical-block (nil '(3)) (write (pprint-pop))))
    (assert (string= "3" (get-output-stream-string s))))
  (let ((s (make-string-output-stream)) (order nil))
    (pprint-logical-block (s (progn (push :object order) nil)
                             :suffix (progn (push :suffix order) "]")
                             :prefix (progn (push :prefix order) "["))
      (declare (optimize (safety 3))))
    (assert (equal order '(:prefix :suffix :object)))
    (assert (string= "[]" (get-output-stream-string s))))
  (assert (handler-case (with-output-to-string (s) (pprint-logical-block (s nil :prefix 3)))
            (type-error () t)))
  (assert (handler-case (eval '(pprint-logical-block (nil nil :prefix "[" :per-line-prefix ">")))
            (error () t)))
  (format t "PPRINT-LOGICAL-BLOCK-OK~%"))

;; Quicklisp's setup helper uses NIL to rebind *STANDARD-OUTPUT*.
(defun quicklisp-wrapped-list (words)
  (let ((*print-right-margin* 12) (*print-pretty* t) (*print-escape* nil))
    (pprint-logical-block (nil words :per-line-prefix "    ")
      (pprint-fill *standard-output* (sort (copy-seq words) #'string<) nil))))

(check-logical-blocks)
(assert (string= (format nil "    alpha~%    beta~%    gamma")
                 (with-output-to-string (*standard-output*)
                   (quicklisp-wrapped-list '("gamma" "alpha" "beta")))))
(format t "QUICKLISP-PPRINT-OK~%")
