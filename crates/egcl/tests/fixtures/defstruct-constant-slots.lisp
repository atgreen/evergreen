(defstruct constant-first t nil)
(defparameter *constant-first* (make-constant-first :t (list 'q) :nil (list 'r)))
;; Keep the original sequence live even if a copier signals: the next type's
;; accessors must remain safe after condition construction and recovery.
(defparameter *constant-copy-error* nil)
(defparameter *constant-copy*
  (handler-case (copy-constant-first *constant-first*)
    (error (condition) (setf *constant-copy-error* condition) nil)))
(defstruct constant-second t nil)
(let ((later (make-constant-second :t 2 :nil 3)))
  (assert (= (constant-second-t later) 2))
  (assert (= (constant-second-nil later) 3)))
(assert (null *constant-copy-error*))
(assert (not (eq *constant-first* *constant-copy*)))
(assert (eq (constant-first-t *constant-first*) (constant-first-t *constant-copy*)))
(assert (eq (constant-first-nil *constant-first*) (constant-first-nil *constant-copy*)))
(setf (constant-first-t *constant-copy*) 'changed)
(assert (consp (constant-first-t *constant-first*)))
(assert (eq (constant-first-t *constant-copy*) 'changed))
(defstruct constant-mixed (before 11) (t 12 :read-only t) (nil 13) (after 14))
(defstruct (constant-child (:include constant-mixed)) (extra 15))
(let* ((original (make-constant-child :t 21 :nil 22))
       (copy (copy-constant-child original)))
  (assert (= (constant-child-before copy) 11))
  (assert (= (constant-child-t copy) 21))
  (assert (= (constant-child-nil copy) 22))
  (assert (= (constant-child-after copy) 14))
  (assert (= (constant-child-extra copy) 15))
  (setf (constant-child-nil copy) 23)
  (assert (= (constant-child-nil original) 22)))
;; An actual caught UNBOUND-SLOT must not change the identity used by later
;; constructor/copier calls, even when no copier failure triggers it anymore.
(slot-makunbound *constant-first* 't)
(assert (handler-case (progn (constant-first-t *constant-first*) nil)
          (unbound-slot () t)))
(defstruct constant-after-error t nil)
(let* ((original (make-constant-after-error :t 31 :nil 32))
       (copy (copy-constant-after-error original)))
  (assert (= (constant-after-error-t copy) 31))
  (assert (= (constant-after-error-nil copy) 32)))
;; Only the canonical bare constants are normalized. Same-spelling symbols
;; owned by another package retain their distinct identities through copying.
(defpackage "CONSTANT-SHADOW" (:use "CL") (:shadow "T" "NIL"))
(assert (not (eq 'constant-shadow::t t)))
(assert (not (eq 'constant-shadow::nil nil)))
(defstruct constant-qualified constant-shadow::t constant-shadow::nil)
(let* ((original (make-constant-qualified :t 41 :nil 42))
       (copy (copy-constant-qualified original)))
  (assert (= (slot-value copy 'constant-shadow::t) 41))
  (assert (= (slot-value copy 'constant-shadow::nil) 42)))
(write-line "DEFSTRUCT-CONSTANT-SLOTS-OK")
