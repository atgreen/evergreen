(defvar *migration-events* nil)
(defvar *migration-defaults* 0)
(defclass migration-before ()
  ((shared :initarg :shared :accessor migration-shared)
   (removed :initarg :removed)))
(defclass migration-after ()
  ((shared :initarg :shared :accessor migration-shared)
   (deadline :initarg :deadline :reader migration-deadline)
   (added :initform (incf *migration-defaults*) :reader migration-added)))

(defmethod update-instance-for-different-class :before
    ((old migration-before) (new migration-after) &rest initargs)
  (push (list :before (migration-shared old) (slot-value old 'removed)
              (slot-boundp new 'deadline)
              (copy-list initargs))
        *migration-events*))
(defmethod update-instance-for-different-class :after
    ((old migration-before) (new migration-after) &rest initargs)
  (declare (ignore old initargs))
  (push (list :after (migration-shared new) (migration-deadline new))
        *migration-events*))

(defun migrate-context (instance class deadline)
  (change-class instance class :deadline deadline :shared :updated))

(dotimes (iteration 30)
  (setf *migration-events* nil)
  (let* ((payload (list :deadline iteration))
         (instance (make-instance 'migration-before :shared :original :removed :old))
         (alias instance)
         (class (if (evenp iteration) 'migration-after (find-class 'migration-after))))
    (assert (eq instance (migrate-context instance class payload)))
    (assert (eq alias instance))
    (assert (typep instance 'migration-after))
    (assert (eq payload (migration-deadline alias)))
    (assert (eq :updated (migration-shared alias)))
    (assert (= (1+ iteration) (migration-added alias)))
    (assert (equal (reverse *migration-events*)
                   (list (list :before :original :old nil
                               (list :deadline payload :shared :updated))
                         (list :after :updated payload))))))
(defclass migration-shared-base ()
  ((allocation-slot :allocation :class :initform :old)))
(defclass migration-shared-child (migration-shared-base) ())
(defclass migration-local-target ()
  ((allocation-slot :initform :new)))
(let ((instance (make-instance 'migration-shared-child)))
  (change-class instance 'migration-local-target)
  (assert (eq :old (slot-value instance 'allocation-slot))))
(defclass migration-unbound-shared-base ()
  ((allocation-slot :allocation :class)))
(defclass migration-unbound-shared-child (migration-unbound-shared-base) ())
(let ((instance (make-instance 'migration-unbound-shared-child)))
  (assert (not (slot-boundp instance 'allocation-slot)))
  (change-class instance 'migration-local-target)
  (assert (not (slot-boundp instance 'allocation-slot))))
(format t "CHANGE-CLASS-INITARGS-PASS~%")
