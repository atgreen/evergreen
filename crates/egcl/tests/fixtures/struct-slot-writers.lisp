(defstruct writer-parent (x 1 :type integer))
(defstruct (writer-child (:include writer-parent (x 2 :type (integer 0 5)))))
(defstruct (writer-list (:type list)) (x 1 :type integer))
(defstruct (writer-vector (:type vector)) (x 1 :type integer))
(defun rejected-writer-value (writer object value)
  (handler-case (progn (funcall writer value object) nil)
    (type-error (condition)
      (assert (eql value (type-error-datum condition)))
      t)))
(let ((object (make-writer-parent)))
  (assert (= 3 (setf (writer-parent-x object) 3)))
  (assert (rejected-writer-value #'(setf writer-parent-x) object :bad))
  (assert (= 3 (writer-parent-x object))))
(let ((object (make-writer-child)))
  (assert (= 4 (setf (writer-parent-x object) 4)))
  #+egcl
  (assert (rejected-writer-value #'(setf writer-parent-x) object 6))
  (assert (rejected-writer-value #'(setf writer-child-x) object 6))
  (assert (rejected-writer-value #'(setf writer-child-x) object :bad))
  (assert (= 4 (writer-child-x object))))
(let ((object (make-writer-list)))
  (assert (= 3 (setf (writer-list-x object) 3)))
  (assert (rejected-writer-value #'(setf writer-list-x) object :bad))
  (assert (= 3 (writer-list-x object))))
(let ((object (make-writer-vector)))
  (assert (= 3 (setf (writer-vector-x object) 3)))
  (assert (rejected-writer-value #'(setf writer-vector-x) object :bad))
  (assert (= 3 (writer-vector-x object))))
(let ((object (make-writer-parent)) (places 0) (values 0))
  (assert (= 4 (setf (writer-parent-x (progn (incf places) object))
                      (progn (incf values) 4))))
  (assert (= 1 places))
  (assert (= 1 values)))
(defun hot-structure-writer (object value)
  (setf (writer-child-x object) value))
(let ((object (make-writer-child)))
  (dotimes (i 30) (assert (= 3 (hot-structure-writer object 3))))
  (assert (handler-case (progn (hot-structure-writer object 8) nil)
            (type-error () t)))
  (assert (= 3 (writer-child-x object))))
(defclass unchecked-class () ((x :initform 1 :type integer :accessor unchecked-x)))
(let ((object (make-instance 'unchecked-class)))
  #+egcl
  (assert (eq :bad (setf (unchecked-x object) :bad))))
(format t "STRUCT-SLOT-WRITERS-OK~%")
