(assert (string= (format nil "~$" (/ 310 1024)) "0.30"))
(assert (string= (format nil "~,3F" -123/1000) "-0.123"))
(assert (string= (format nil "~,3F" 1/3) "0.333"))
(assert (string= (format nil "~v$" 3 5/4) "1.250"))
(assert (string= (format nil "~@$" 5/4) "+1.25"))
(dolist (control '("~E" "~G"))
  (assert (= (read-from-string (format nil control 5/4)) 1.25)))
(let ((large (expt 2 64)))
  (assert (string= (format nil "~$" large) "18446744073709551616.00"))
  (assert (string= (format nil "~,1F" large)
                   (format nil "~,1F" (float large 1d0)))))
(let ((huge (expt 2 2048)))
  (assert (string= (format nil "~,3F" (/ (1+ huge) (1- huge))) "1.000"))
  (assert (handler-case (progn (format nil "~,3F" huge) nil)
            (arithmetic-error () t))))
(write-line "FORMAT-RATIONALS-PASS")
