;;; A leading ~& asks the destination whether its line already holds output
;;; (CLHS 22.3.1.3; GitHub #941).
(defun out (f) (with-output-to-string (s) (funcall f s)))
(defun two (s) (make-two-way-stream (make-string-input-stream "") s))
(defun fresh-x (s) (format s "~&x"))
(defparameter *fresh-x* (formatter "~&x"))
(defparameter *nl* (string #\Newline))
(defun check (name f expected)
  (let ((got (out f)))
    (unless (equal got expected)
      (error "~a: got ~s, expected ~s" name got expected))))
(defun run-checks ()
  (check "at start" (lambda (s) (format s "~&x")) "x")
  (check "mid-line" (lambda (s) (write-string "a" s) (format s "~&x"))
         (concatenate 'string "a" *nl* "x"))
  (check "~2& mid-line" (lambda (s) (write-string "a" s) (format s "~2&x"))
         (concatenate 'string "a" *nl* *nl* "x"))
  (check "~2& at start" (lambda (s) (format s "~2&x")) (concatenate 'string *nl* "x"))
  (check "after newline" (lambda (s) (write-line "a" s) (format s "~&x"))
         (concatenate 'string "a" *nl* "x"))
  (check "format nil" (lambda (s) (write-string (format nil "~&x") s)) "x")
  (check "function mid-line" (lambda (s) (write-string "a" s) (fresh-x s))
         (concatenate 'string "a" *nl* "x"))
  (check "formatter mid-line" (lambda (s) (write-string "a" s) (format s *fresh-x*))
         (concatenate 'string "a" *nl* "x"))
  (check "formatter at start" (lambda (s) (format s *fresh-x*)) "x")
  (check "broadcast mid-line"
         (lambda (s) (let ((b (make-broadcast-stream s))) (write-string "a" b) (format b "~&x")))
         (concatenate 'string "a" *nl* "x"))
  (check "broadcast at start" (lambda (s) (format (make-broadcast-stream s) "~&x")) "x")
  (check "two-way at start" (lambda (s) (format (two s) "~&x")) "x")
  (check "two-way mid-line" (lambda (s) (write-string "a" s) (format (two s) "~&x"))
         (concatenate 'string "a" *nl* "x"))
  (check "case conversion mid-line" (lambda (s) (format s "a~(~&X~)"))
         (concatenate 'string "a" *nl* "x"))
  (check "two-way column" (lambda (s) (write-string "ab" s) (format (two s) "~5Tx")) "ab   x"))
(run-checks)
(format t "~&FORMAT-FRESH-LINE-PASS~%")
