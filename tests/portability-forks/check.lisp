(require :asdf)
(asdf:initialize-source-registry '(:source-registry :ignore-inherited-configuration))
(asdf:initialize-output-translations
 (list :output-translations (list t (uiop:getenv "EGCL_PORT_CACHE")) :ignore-inherited-configuration))
(load (uiop:getenv "EGCL_PORT_RUNTIME"))
(setf ocicl-runtime:*local-only* t ocicl-runtime:*download* nil)
(dolist (system '("archive" "zip" "unix-opts" "with-user-abort" "local-time" "parachute"))
  (asdf:load-system system))
(require :egcl-posix)
(with-open-file (s "input.dat" :direction :output :if-exists :supersede)
  (write-string "port test" s))
(egcl-posix:chmod "input.dat" #o640)
(let ((stat (archive::stat "input.dat"))
      (native (egcl-posix:stat "input.dat")))
  (assert (= 9 (archive::stat-size stat)))
  (assert (= #o640 (logand #o777 (archive::stat-mode stat))))
  (dolist (field '(mode uid gid size mtime ino nlink))
    (let ((name (format nil "STAT-~A" field)))
      (assert (= (funcall (find-symbol name :archive) stat)
                 (funcall (find-symbol name :egcl-posix) native))))))
(assert (handler-case (progn (archive::stat "absent.dat") nil)
          (egcl-posix:syscall-error () t)))
(archive:with-open-archive (a "roundtrip.tar" :direction :output :if-exists :supersede)
  (archive:write-entry-to-archive a (archive:create-entry-from-pathname a "input.dat"))
  (archive:finalize-archive a))
(archive:with-open-archive (a "roundtrip.tar")
  (let ((entry (archive:read-entry-from-archive a)))
    (assert (archive:entry-regular-file-p entry))
    (assert (string= "input.dat" (archive:name entry)))))
(assert (= #o640 (logand #o777 (zip::file-mode "input.dat"))))
(zip:with-output-to-zipfile (z "roundtrip.zip" :if-exists :supersede)
  (zip:write-zipentry z "input.dat" #p"input.dat" :deflate nil))
(zip:with-zipfile (z "roundtrip.zip")
  (let ((entry (gethash "input.dat" (zip:zipfile-entries z))))
    (assert entry)
    (assert (equalp #(112 111 114 116 32 116 101 115 116)
                    (zip:zipfile-entry-contents entry)))))
(assert (equal (opts:argv) (egcl-ext:raw-command-line-arguments)))
(assert (opts:argv))
(assert (handler-case
            (with-user-abort:with-user-abort
              (signal 'egcl-ext:interrupt-condition) nil)
          (with-user-abort:user-abort () t)))
(let ((fraction nil))
  (dotimes (i 10)
    (multiple-value-bind (before-sec before-nsec) (egcl-ext:get-precise-time)
      (multiple-value-bind (seconds nanos) (local-time::%get-current-time)
        (multiple-value-bind (after-sec after-nsec) (egcl-ext:get-precise-time)
          (assert (<= (+ (* before-sec 1000000000) before-nsec)
                      (+ (* (+ seconds 2208988800) 1000000000) nanos)
                      (+ (* after-sec 1000000000) after-nsec)))
          (when (plusp nanos) (setf fraction t))))))
  (assert fraction))
(format t "PORTABILITY-FORKS-PASS~%")
(let ((mode (uiop:getenv "EGCL_PORT_EXIT")))
  (cond ((equal mode "unix-opts") (opts:exit 23))
        ((equal mode "parachute") (parachute:quit 24))
        (t (uiop:quit 0))))
(error "Exit adapter returned")
