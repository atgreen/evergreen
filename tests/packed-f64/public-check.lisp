;; Public acceptance for bliss-0zgjy.2. Native/T2 execution is a separate gate.
(assert (eq (upgraded-array-element-type 'double-float) 'double-float))
(assert (eq (upgraded-array-element-type '(double-float 0d0 10d0)) 'double-float))

(defun check-double-array-type (array expected)
  (assert (eq (array-element-type array) 'double-float))
  (assert (typep array expected))
  (let ((reported (type-of array)))
    (assert (consp reported))
    (assert (eq (cadr reported) 'double-float))
    (assert (typep array reported)))
  (assert (not (simple-vector-p array))))

(let ((empty (make-array 0 :element-type 'double-float))
      (scalar (make-array nil :element-type 'double-float :initial-element 1d0))
      (vector (make-array 3 :element-type 'double-float
                            :initial-contents '(1d0 2d0 3d0)))
      (matrix (make-array '(2 2) :element-type 'double-float
                                 :initial-contents '((1d0 2d0) (3d0 4d0)))))
  (check-double-array-type empty '(simple-array double-float (0)))
  (check-double-array-type scalar '(simple-array double-float ()))
  (check-double-array-type vector '(simple-array double-float (3)))
  (check-double-array-type matrix '(simple-array double-float (2 2)))
  (assert (not (typep vector '(vector t))))
  (assert (= (aref scalar) 1d0))
  (setf (aref scalar) 8d0)
  (assert (= (row-major-aref scalar 0) 8d0))
  (let ((printed (format nil "~S" scalar)))
    (assert (search "#0A" printed))
    (assert (search "8" printed)))
  (assert (= (aref matrix 1 1) 4d0))
  (setf (aref matrix 1 1) 9d0)
  (assert (= (row-major-aref matrix 3) 9d0))
  (setf (aref vector 1) -3.5d0)
  (assert (equalp vector #(1d0 -3.5d0 3d0)))
  (assert (equalp (coerce vector 'list) '(1d0 -3.5d0 3d0)))
  (assert (handler-case (progn (setf (aref vector 0) 1) nil) (type-error () t)))
  (assert (handler-case (progn (aref vector 3) nil) (type-error () t)))
  (assert (handler-case (progn (aref empty 0) nil) (type-error () t)))
  (assert (handler-case (progn (aref matrix 2 0) nil) (type-error () t)))
  (check-double-array-type (copy-seq vector) '(simple-array double-float (3)))
  (check-double-array-type (subseq vector 1) '(simple-array double-float (2)))
  (check-double-array-type (reverse vector) '(simple-array double-float (3))))

(let* ((base (make-array 4 :element-type 'double-float
                           :initial-contents '(10d0 20d0 30d0 40d0)))
       (view (make-array 2 :element-type 'double-float
                           :displaced-to base :displaced-index-offset 1))
       (adjustable (make-array 3 :element-type 'double-float :adjustable t
                                :fill-pointer 2 :initial-element 1d0)))
  (check-double-array-type view '(array double-float (2)))
  (check-double-array-type adjustable '(array double-float (3)))
  (assert (not (typep view '(simple-array double-float (*)))))
  (assert (not (typep adjustable '(simple-array double-float (*)))))
  (assert (equalp view #(20d0 30d0)))
  (setf (aref view 1) 7d0)
  (assert (= (aref base 2) 7d0))
  (setf (aref base 1) 8d0)
  (assert (= (aref view 0) 8d0))
  (multiple-value-bind (array offset) (array-displacement view)
    (assert (eq array base))
    (assert (= offset 1)))
  (assert (= (length adjustable) 2))
  (assert (= (array-total-size adjustable) 3))
  (assert (= (vector-push 2d0 adjustable) 2))
  (assert (= (vector-push-extend 3d0 adjustable) 3))
  (assert (= (vector-pop adjustable) 3d0))
  (assert (eq (adjust-array adjustable 20 :initial-element 4d0) adjustable))
  (check-double-array-type adjustable '(array double-float (20)))
  (assert (= (length adjustable) 3))
  (assert (= (aref adjustable 19) 4d0))
  (check-double-array-type (copy-seq adjustable) '(simple-array double-float (3)))
  (check-double-array-type (copy-seq view) '(simple-array double-float (2))))

(let ((sequence (make-sequence '(vector double-float) 3 :initial-element 2d0))
      (coerced (coerce '(1d0 2d0) '(vector double-float)))
      (joined (concatenate '(vector double-float) '(1d0) '(2d0))))
  (check-double-array-type sequence '(simple-array double-float (3)))
  (check-double-array-type coerced '(simple-array double-float (2)))
  (check-double-array-type joined '(simple-array double-float (2)))
  (assert (equalp coerced joined)))
(let* ((packed (make-array 2 :element-type 'double-float :initial-element -0d0))
       (table (make-hash-table :test 'equalp)))
  (setf (gethash packed table) :found)
  (assert (eq (gethash #(0d0 0d0) table) :found))
  (assert (eq (gethash #(0 0) table) :found))
  (assert (eq (gethash (copy-seq packed) table) :found))
  (assert (= (loop for item across packed sum item) 0d0)))

(let ((matrix (make-array '(1 2) :element-type 'double-float :initial-element -4.5d0)))
  (assert (search "-4.5" (format nil "~S" matrix)))
  (assert (equalp matrix (make-array '(1 2) :initial-element -4.5d0)))
  (assert (handler-case (progn (setf (aref matrix 0 0) 1) nil) (type-error () t))))

(format t "Public packed double-float array checks passed.~%")
