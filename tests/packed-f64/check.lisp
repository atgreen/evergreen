(let ((v (egcl-internal::%make-double-float-vector 3 1.25d0)))
  (assert (= (length v) 3))
  (assert (vectorp v))
  (assert (not (simple-vector-p v)))
  (assert (eq (array-element-type v) 'double-float))
  (assert (= (aref v 2) 1.25d0))
  (setf (aref v 1) -3.5d0)
  (assert (= (aref v 1) -3.5d0))
  (assert (equalp v #(1.25d0 -3.5d0 1.25d0)))
  (assert (equalp (coerce v 'list) '(1.25d0 -3.5d0 1.25d0)))
  (assert (equalp (concatenate 'vector v v) #(1.25d0 -3.5d0 1.25d0 1.25d0 -3.5d0 1.25d0)))
  (let ((target (list nil nil nil)))
    (setf (subseq target 0) v)
    (assert (equalp target '(1.25d0 -3.5d0 1.25d0))))
  (assert (handler-case (progn (setf (aref v 0) 1) nil) (type-error () t)))
  (assert (handler-case (progn (aref v 3) nil) (type-error () t)))
  (let ((copy (copy-seq v)) (part (subseq v 1 3)))
    (assert (not (eq copy v)))
    (assert (eq (array-element-type copy) 'double-float))
    (assert (eq (array-element-type part) 'double-float))
    (assert (= (aref part 0) -3.5d0))
    (assert (= (aref (reverse part) 1) -3.5d0))))
(format t "Packed double-float vector checks passed.~%")
