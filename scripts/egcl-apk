#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later WITH Classpath-exception-2.0
#
# Build a project's APK from the source tree. The real launcher is
# packaging/android/egcl-apk, which egcl-target-android installs as
# /usr/bin/egcl-apk; this only points it at the tree instead of at /usr, so the
# two cannot drift.
#
# SBCL is the default here because it loads the builder in about a second; set
# EGCL_BIN to build with EGCL instead (which then caches a saved image).
set -eu
repo=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
export EGCL_APK_BUILDER="${EGCL_APK_BUILDER:-$repo/lib/egcl-apk}"
export EGCL_APK_ASDF="${EGCL_APK_ASDF:-$repo/lib/asdf.lisp}"
if [ -z "${EGCL_BIN:-}" ]; then
    export SBCL_BIN="${SBCL_BIN:-sbcl}"
fi
exec "$repo/packaging/android/egcl-apk" "$@"
