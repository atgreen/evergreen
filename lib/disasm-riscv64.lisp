(defun csr-name (number)
  (or (cdr (assoc number *csr-names*)) (format nil "0x~(~X~)" number)))

(defparameter *rounding-modes* #("rne" "rtz" "rdn" "rup" "rmm" nil nil nil))

;;; ------------------------------------------------------------------
;;; Operand formatting

(defun ops (&rest parts)
  (format nil "~{~A~^,~}" parts))

(defun hex (value)
  "VALUE in objdump's lowercase hex, negative values as 64-bit two's complement."
  (format nil "0x~(~X~)" (logand value #xffffffffffffffff)))

(defun mem (offset base)
  (format nil "~D(~A)" offset base))

(defun fence-set (mask)
  (with-output-to-string (out)
    (when (logbitp 3 mask) (write-char #\i out))
    (when (logbitp 2 mask) (write-char #\o out))
    (when (logbitp 1 mask) (write-char #\r out))
    (when (logbitp 0 mask) (write-char #\w out))))

(defun with-rm (mnemonic operands rm)
  "Append the explicit rounding mode objdump prints when RM is not dynamic."
  (if (= rm 7)
      (values mnemonic operands)
      (values mnemonic (format nil "~A,~A" operands (or (aref *rounding-modes* rm) "unknown")))))

;;; ------------------------------------------------------------------
;;; Address comments
;;;
;;; objdump remembers the upper bits a LUI or AUIPC left in a register and, on
;;; the next load, store, ADDI, ADDIW or JALR through that register, appends
;;; `# 0xADDR` with the completed address, then forgets it. A base of ZERO or
;;; TP prints the plain offset. Mirrored here so pool loads read the same.

(defvar *hi-addr* (make-array 32 :initial-element nil))
(defvar *address-comment* nil)

(defun reset-address-state ()
  (fill *hi-addr* nil)
  (setf *address-comment* nil))

(defun note-hi-addr (rd value)
  (when (/= rd 0) (setf (aref *hi-addr* rd) value)))

(defun maybe-print-address (base offset &optional wide)
  (let ((hi (aref *hi-addr* base)))
    (cond (hi
           (setf *address-comment* (+ hi offset))
           (setf (aref *hi-addr* base) nil))
          ((or (= base 0) (= base 4))
           (setf *address-comment* offset))
          (t (return-from maybe-print-address nil)))
    (when wide
      (setf *address-comment*
            (signed (logand *address-comment* #xffffffff) 32)))))

;;; ------------------------------------------------------------------
;;; Instruction length

(defun instruction-length (bytes pos)
  "The architectural length in bytes of the encoding at POS, following
binutils: 2, 4, 6, 8, or 10 + 2n, with the reserved 192-bit-and-longer shape
counted as two bytes so decoding can continue."
  (let ((b0 (aref bytes pos))
        (half (if (< (1+ pos) (length bytes))
                  (logior (aref bytes pos) (ash (aref bytes (1+ pos)) 8))
                  (aref bytes pos))))
    (cond ((/= (logand b0 3) 3) 2)
          ((/= (logand b0 #x1f) #x1f) 4)
          ((= (logand b0 #x3f) #x1f) 6)
          ((= (logand b0 #x7f) #x3f) 8)
          ((/= (bits half 14 12) 7) (+ 10 (* 2 (bits half 14 12))))
          (t 2))))

;;; ------------------------------------------------------------------
;;; 32-bit instructions

(defun i-imm (w) (signed (bits w 31 20) 12))
(defun s-imm (w) (signed (logior (ash (bits w 31 25) 5) (bits w 11 7)) 12))
(defun b-imm (w)
  (signed (logior (ash (bit1 w 31) 12) (ash (bit1 w 7) 11)
                  (ash (bits w 30 25) 5) (ash (bits w 11 8) 1))
          13))
(defun u-imm (w) (bits w 31 12))
(defun j-imm (w)
  (signed (logior (ash (bit1 w 31) 20) (ash (bits w 19 12) 12)
                  (ash (bit1 w 20) 11) (ash (bits w 30 21) 1))
          21))

(defun decode-op-imm (w rd rs1 f3)
  (let ((imm (i-imm w)))
    (case f3
      (0 (when (and (/= rs1 0) (/= imm 0)) (maybe-print-address rs1 imm))
         (cond ((and (= rd 0) (= rs1 0) (= imm 0)) (values "nop" ""))
               ((= rs1 0) (values "li" (ops (x rd) imm)))
               ((= imm 0) (values "mv" (ops (x rd) (x rs1))))
               (t (values "addi" (ops (x rd) (x rs1) imm)))))
      (1 (if (= (bits w 31 26) 0)
             (values "slli" (ops (x rd) (x rs1) (hex (bits w 25 20))))
             (values nil nil)))
      (2 (values "slti" (ops (x rd) (x rs1) imm)))
      (3 (if (= imm 1)
             (values "seqz" (ops (x rd) (x rs1)))
             (values "sltiu" (ops (x rd) (x rs1) imm))))
      (4 (if (= imm -1)
             (values "not" (ops (x rd) (x rs1)))
             (values "xori" (ops (x rd) (x rs1) imm))))
      (5 (case (bits w 31 26)
           (0 (values "srli" (ops (x rd) (x rs1) (hex (bits w 25 20)))))
           (#x10 (values "srai" (ops (x rd) (x rs1) (hex (bits w 25 20)))))
           (t (values nil nil))))
      (6 (values "ori" (ops (x rd) (x rs1) imm)))
      (7 (values "andi" (ops (x rd) (x rs1) imm))))))

(defun decode-op-imm-32 (w rd rs1 f3)
  (let ((imm (i-imm w)))
    (case f3
      (0 (when (and (/= rs1 0) (/= imm 0)) (maybe-print-address rs1 imm t))
         (if (= imm 0)
             (values "sext.w" (ops (x rd) (x rs1)))
             (values "addiw" (ops (x rd) (x rs1) imm))))
      (1 (if (= (bits w 31 25) 0)
             (values "slliw" (ops (x rd) (x rs1) (hex (bits w 24 20))))
             (values nil nil)))
      (5 (case (bits w 31 25)
           (0 (values "srliw" (ops (x rd) (x rs1) (hex (bits w 24 20)))))
           (#x20 (values "sraiw" (ops (x rd) (x rs1) (hex (bits w 24 20)))))
           (t (values nil nil))))
      (t (values nil nil)))))

(defparameter *op-names*
  ;; (funct7 . #(names by funct3)); NIL marks an undefined combination.
  '((#x00 . #("add" "sll" "slt" "sltu" "xor" "srl" "or" "and"))
    (#x20 . #("sub" nil nil nil nil "sra" nil nil))
    (#x01 . #("mul" "mulh" "mulhsu" "mulhu" "div" "divu" "rem" "remu"))))

(defparameter *op-32-names*
  '((#x00 . #("addw" "sllw" nil nil nil "srlw" nil nil))
    (#x20 . #("subw" nil nil nil nil "sraw" nil nil))
    (#x01 . #("mulw" nil nil nil "divw" "divuw" "remw" "remuw"))))

(defun decode-op (w rd rs1 rs2 f3 f7 table)
  (let ((name (let ((row (cdr (assoc f7 table)))) (and row (aref row f3)))))
    (cond ((null name) (values nil nil))
          ((and (string= name "sub") (= rs1 0)) (values "neg" (ops (x rd) (x rs2))))
          ((and (string= name "sltu") (= rs1 0)) (values "snez" (ops (x rd) (x rs2))))
          ((and (string= name "slt") (= rs1 0)) (values "sgtz" (ops (x rd) (x rs2))))
          ((and (string= name "slt") (= rs2 0)) (values "sltz" (ops (x rd) (x rs1))))
          (t (values name (ops (x rd) (x rs1) (x rs2)))))))

(defparameter *branch-names* #("beq" "bne" nil nil "blt" "bge" "bltu" "bgeu"))

(defun decode-branch (w rs1 rs2 f3 pos tp)
  (let ((name (aref *branch-names* f3))
        (target (funcall tp (+ pos (b-imm w)))))
    (cond ((null name) (values nil nil))
          ((and (= rs2 0) (member name '("beq" "bne" "blt" "bge") :test #'string=))
           (values (format nil "~Az" name) (ops (x rs1) target)))
          ((and (= rs1 0) (string= name "blt")) (values "bgtz" (ops (x rs2) target)))
          ((and (= rs1 0) (string= name "bge")) (values "blez" (ops (x rs2) target)))
          (t (values name (ops (x rs1) (x rs2) target))))))

(defun decode-jalr (w rd rs1)
  (let ((imm (i-imm w)))
    (maybe-print-address rs1 imm)
    (cond ((and (= rd 0) (= rs1 1) (= imm 0)) (values "ret" ""))
          ((and (= rd 0) (= imm 0)) (values "jr" (x rs1)))
          ((and (= rd 1) (= imm 0)) (values "jalr" (x rs1)))
          ((= rd 0) (values "jr" (mem imm (x rs1))))
          ((= rd 1) (values "jalr" (mem imm (x rs1))))
          ((= imm 0) (values "jalr" (ops (x rd) (x rs1))))
          (t (values "jalr" (ops (x rd) (mem imm (x rs1))))))))

(defun decode-jal (w rd pos tp)
  (let ((target (funcall tp (+ pos (j-imm w)))))
    (case rd
      (0 (values "j" target))
      (1 (values "jal" target))
      (t (values "jal" (ops (x rd) target))))))

(defun decode-system (w rd rs1 f3)
  (let ((csr (bits w 31 20)))
    (case f3
      (0 (if (and (= rd 0) (= rs1 0))
             (case csr
               (0 (values "ecall" ""))
               (1 (values "ebreak" ""))
               (#x102 (values "sret" ""))
               (#x302 (values "mret" ""))
               (#x105 (values "wfi" ""))
               (t (values nil nil)))
             (values nil nil)))
      (1 (cond ((and (= csr 3) (= rd 0)) (values "fscsr" (x rs1)))
               ((= csr 3) (values "fscsr" (ops (x rd) (x rs1))))
               ((and (= csr 2) (= rd 0)) (values "fsrm" (x rs1)))
               ((= csr 2) (values "fsrm" (ops (x rd) (x rs1))))
               ((and (= csr 1) (= rd 0)) (values "fsflags" (x rs1)))
               ((= csr 1) (values "fsflags" (ops (x rd) (x rs1))))
               ((= rd 0) (values "csrw" (ops (csr-name csr) (x rs1))))
               (t (values "csrrw" (ops (x rd) (csr-name csr) (x rs1))))))
      (2 (cond ((/= rs1 0)
                (if (= rd 0)
                    (values "csrs" (ops (csr-name csr) (x rs1)))
                    (values "csrrs" (ops (x rd) (csr-name csr) (x rs1)))))
               ((= csr 3) (values "frcsr" (x rd)))
               ((= csr 2) (values "frrm" (x rd)))
               ((= csr 1) (values "frflags" (x rd)))
               ((= csr #xc00) (values "rdcycle" (x rd)))
               ((= csr #xc01) (values "rdtime" (x rd)))
               ((= csr #xc02) (values "rdinstret" (x rd)))
               (t (values "csrr" (ops (x rd) (csr-name csr))))))
      (3 (if (= rd 0)
             (values "csrc" (ops (csr-name csr) (x rs1)))
             (values "csrrc" (ops (x rd) (csr-name csr) (x rs1)))))
      (5 (if (= rd 0)
             (values "csrwi" (ops (csr-name csr) rs1))
             (values "csrrwi" (ops (x rd) (csr-name csr) rs1))))
      (6 (if (= rd 0)
             (values "csrsi" (ops (csr-name csr) rs1))
             (values "csrrsi" (ops (x rd) (csr-name csr) rs1))))
      (7 (if (= rd 0)
             (values "csrci" (ops (csr-name csr) rs1))
             (values "csrrci" (ops (x rd) (csr-name csr) rs1))))
      (t (values nil nil)))))

(defparameter *amo-names*
  '((2 . "lr") (3 . "sc") (1 . "amoswap") (0 . "amoadd") (4 . "amoxor")
    (12 . "amoand") (8 . "amoor") (16 . "amomin") (20 . "amomax")
    (24 . "amominu") (28 . "amomaxu")))

(defun decode-amo (w rd rs1 rs2 f3 f7)
  (let ((name (cdr (assoc (ash f7 -2) *amo-names*)))
        (width (case f3 (2 ".w") (3 ".d") (t nil)))
        (order (case (logand f7 3) (0 "") (1 ".rl") (2 ".aq") (3 ".aqrl"))))
    (cond ((or (null name) (null width)) (values nil nil))
          ((string= name "lr")
           (if (= rs2 0)
               (values (format nil "lr~A~A" width order) (ops (x rd) (format nil "(~A)" (x rs1))))
               (values nil nil)))
          (t (values (format nil "~A~A~A" name width order)
                     (ops (x rd) (x rs2) (format nil "(~A)" (x rs1))))))))

(defun fp-suffix (fmt)
  (case fmt (0 "s") (1 "d")))

(defun decode-fp-fused (w rd rs1 rs2 base)
  (let ((fmt (fp-suffix (bits w 26 25)))
        (rs3 (bits w 31 27))
        (rm (bits w 14 12)))
    (if fmt
        (with-rm (format nil "~A.~A" base fmt) (ops (f rd) (f rs1) (f rs2) (f rs3)) rm)
        (values nil nil))))

(defun decode-op-fp (w rd rs1 rs2 f3 f7)
  (let* ((fmt-bits (bits w 26 25))
         (fmt (fp-suffix fmt-bits))
         (op (bits w 31 27))
         (rm f3))
    (when (null fmt) (return-from decode-op-fp (values nil nil)))
    (case op
      (#x00 (with-rm (format nil "fadd.~A" fmt) (ops (f rd) (f rs1) (f rs2)) rm))
      (#x01 (with-rm (format nil "fsub.~A" fmt) (ops (f rd) (f rs1) (f rs2)) rm))
      (#x02 (with-rm (format nil "fmul.~A" fmt) (ops (f rd) (f rs1) (f rs2)) rm))
      (#x03 (with-rm (format nil "fdiv.~A" fmt) (ops (f rd) (f rs1) (f rs2)) rm))
      (#x0b (if (= rs2 0)
                (with-rm (format nil "fsqrt.~A" fmt) (ops (f rd) (f rs1)) rm)
                (values nil nil)))
      (#x04 (case f3
              (0 (if (= rs1 rs2)
                     (values (format nil "fmv.~A" fmt) (ops (f rd) (f rs1)))
                     (values (format nil "fsgnj.~A" fmt) (ops (f rd) (f rs1) (f rs2)))))
              (1 (if (= rs1 rs2)
                     (values (format nil "fneg.~A" fmt) (ops (f rd) (f rs1)))
                     (values (format nil "fsgnjn.~A" fmt) (ops (f rd) (f rs1) (f rs2)))))
              (2 (if (= rs1 rs2)
                     (values (format nil "fabs.~A" fmt) (ops (f rd) (f rs1)))
                     (values (format nil "fsgnjx.~A" fmt) (ops (f rd) (f rs1) (f rs2)))))
              (t (values nil nil))))
      (#x05 (case f3
              (0 (values (format nil "fmin.~A" fmt) (ops (f rd) (f rs1) (f rs2))))
              (1 (values (format nil "fmax.~A" fmt) (ops (f rd) (f rs1) (f rs2))))
              (t (values nil nil))))
      (#x08 (let ((from (fp-suffix rs2)))
              (cond ((or (null from) (= rs2 fmt-bits)) (values nil nil))
                    ;; Widening is exact: objdump prints no rounding mode.
                    ((= fmt-bits 1) (values "fcvt.d.s" (ops (f rd) (f rs1))))
                    (t (with-rm (format nil "fcvt.~A.~A" fmt from) (ops (f rd) (f rs1)) rm)))))
      (#x14 (case f3
              (0 (values (format nil "fle.~A" fmt) (ops (x rd) (f rs1) (f rs2))))
              (1 (values (format nil "flt.~A" fmt) (ops (x rd) (f rs1) (f rs2))))
              (2 (values (format nil "feq.~A" fmt) (ops (x rd) (f rs1) (f rs2))))
              (t (values nil nil))))
      (#x18 (let ((int (case rs2 (0 "w") (1 "wu") (2 "l") (3 "lu"))))
              (if int
                  (with-rm (format nil "fcvt.~A.~A" int fmt) (ops (x rd) (f rs1)) rm)
                  (values nil nil))))
      (#x1a (let ((int (case rs2 (0 "w") (1 "wu") (2 "l") (3 "lu"))))
              (cond ((null int) (values nil nil))
                    ;; A 32-bit integer fits a double exactly: no rounding mode.
                    ((and (= fmt-bits 1) (< rs2 2))
                     (values (format nil "fcvt.d.~A" int) (ops (f rd) (x rs1))))
                    (t (with-rm (format nil "fcvt.~A.~A" fmt int) (ops (f rd) (x rs1)) rm)))))
      (#x1c (cond ((and (= f3 0) (= rs2 0))
                   (values (if (= fmt-bits 0) "fmv.x.w" (format nil "fmv.x.~A" fmt))
                           (ops (x rd) (f rs1))))
                  ((and (= f3 1) (= rs2 0))
                   (values (format nil "fclass.~A" fmt) (ops (x rd) (f rs1))))
                  (t (values nil nil))))
      (#x1e (if (and (= f3 0) (= rs2 0))
                (values (if (= fmt-bits 0) "fmv.w.x" (format nil "fmv.~A.x" fmt))
                        (ops (f rd) (x rs1)))
                (values nil nil)))
      (t (values nil nil)))))

(defun decode-32 (w pos tp)
  "Decode a 32-bit instruction word. Returns (VALUES MNEMONIC OPERANDS), with
MNEMONIC NIL for an encoding the tables do not know."
  (let ((opcode (bits w 6 0))
        (rd (bits w 11 7))
        (f3 (bits w 14 12))
        (rs1 (bits w 19 15))
        (rs2 (bits w 24 20))
        (f7 (bits w 31 25)))
    (case opcode
      (#x03 (let ((name (aref #("lb" "lh" "lw" "ld" "lbu" "lhu" "lwu" nil) f3)))
              (cond (name (maybe-print-address rs1 (i-imm w))
                          (values name (ops (x rd) (mem (i-imm w) (x rs1)))))
                    (t (values nil nil)))))
      (#x07 (case f3
              (2 (maybe-print-address rs1 (i-imm w))
                 (values "flw" (ops (f rd) (mem (i-imm w) (x rs1)))))
              (3 (maybe-print-address rs1 (i-imm w))
                 (values "fld" (ops (f rd) (mem (i-imm w) (x rs1)))))
              (t (values nil nil))))
      (#x0f (cond ((or (/= rd 0) (/= rs1 0)) (values nil nil))
                  ((= f3 0)
                   (let ((pred (bits w 27 24)) (succ (bits w 23 20)) (fm (bits w 31 28)))
                     (cond ((and (= fm 8) (= pred 3) (= succ 3)) (values "fence.tso" ""))
                           ((/= fm 0) (values nil nil))
                           ((and (= pred 15) (= succ 15)) (values "fence" ""))
                           (t (values "fence" (ops (fence-set pred) (fence-set succ)))))))
                  ((and (= f3 1) (= (bits w 31 20) 0)) (values "fence.i" ""))
                  (t (values nil nil))))
      (#x13 (decode-op-imm w rd rs1 f3))
      (#x17 (note-hi-addr rd (+ pos (signed (ash (u-imm w) 12) 32)))
            (values "auipc" (ops (x rd) (hex (u-imm w)))))
      (#x1b (decode-op-imm-32 w rd rs1 f3))
      (#x23 (let ((name (aref #("sb" "sh" "sw" "sd" nil nil nil nil) f3)))
              (cond (name (maybe-print-address rs1 (s-imm w))
                          (values name (ops (x rs2) (mem (s-imm w) (x rs1)))))
                    (t (values nil nil)))))
      (#x27 (case f3
              (2 (maybe-print-address rs1 (s-imm w))
                 (values "fsw" (ops (f rs2) (mem (s-imm w) (x rs1)))))
              (3 (maybe-print-address rs1 (s-imm w))
                 (values "fsd" (ops (f rs2) (mem (s-imm w) (x rs1)))))
              (t (values nil nil))))
      (#x2f (decode-amo w rd rs1 rs2 f3 f7))
      (#x33 (decode-op w rd rs1 rs2 f3 f7 *op-names*))
      (#x37 (note-hi-addr rd (signed (ash (u-imm w) 12) 32))
            (values "lui" (ops (x rd) (hex (u-imm w)))))
      (#x3b (decode-op w rd rs1 rs2 f3 f7 *op-32-names*))
      (#x43 (decode-fp-fused w rd rs1 rs2 "fmadd"))
      (#x47 (decode-fp-fused w rd rs1 rs2 "fmsub"))
      (#x4b (decode-fp-fused w rd rs1 rs2 "fnmsub"))
      (#x4f (decode-fp-fused w rd rs1 rs2 "fnmadd"))
      (#x53 (decode-op-fp w rd rs1 rs2 f3 f7))
      (#x63 (decode-branch w rs1 rs2 f3 pos tp))
      (#x67 (if (= f3 0) (decode-jalr w rd rs1) (values nil nil)))
      (#x6f (decode-jal w rd pos tp))
      (#x73 (decode-system w rd rs1 f3))
      (t (values nil nil)))))

;;; ------------------------------------------------------------------
;;; 16-bit (C extension) instructions, printed under their expanded names
;;; as objdump does by default.

(defun c-shamt (h)
  (logior (ash (bit1 h 12) 5) (bits h 6 2)))

(defun decode-16 (h pos tp)
  (when (= h 0) (return-from decode-16 (values "unimp" "")))
  (let ((op (bits h 1 0))
        (f3 (bits h 15 13))
        (rd (bits h 11 7))
        (rs2 (bits h 6 2))
        (rd3 (bits h 9 7))
        (rs2-3 (bits h 4 2)))
    (case op
      (0 (case f3
           (0 (let ((uimm (logior (ash (bits h 10 7) 6) (ash (bits h 12 11) 4)
                                  (ash (bit1 h 5) 3) (ash (bit1 h 6) 2))))
                (if (= uimm 0)
                    (values nil nil)
                    (values "addi" (ops (xc rs2-3) "sp" uimm)))))
           ((1 3 5 7)
            (let ((uimm (logior (ash (bits h 12 10) 3) (ash (bits h 6 5) 6))))
              (case f3
                (1 (values "fld" (ops (fc rs2-3) (mem uimm (xc rd3)))))
                (3 (values "ld" (ops (xc rs2-3) (mem uimm (xc rd3)))))
                (5 (values "fsd" (ops (fc rs2-3) (mem uimm (xc rd3)))))
                (7 (values "sd" (ops (xc rs2-3) (mem uimm (xc rd3))))))))
           ((2 6)
            (let ((uimm (logior (ash (bits h 12 10) 3) (ash (bit1 h 6) 2) (ash (bit1 h 5) 6))))
              (if (= f3 2)
                  (values "lw" (ops (xc rs2-3) (mem uimm (xc rd3))))
                  (values "sw" (ops (xc rs2-3) (mem uimm (xc rd3)))))))
           (t (values nil nil))))
      (1 (case f3
           (0 (let ((imm (signed (logior (ash (bit1 h 12) 5) (bits h 6 2)) 6)))
                (cond ((= rd 0) (if (= imm 0) (values "nop" "") (values "c.nop" (format nil "~D" imm))))
                      ;; Unlike the 32-bit form, a compressed addi with a zero
                      ;; immediate is a hint objdump still prints as addi, and
                      ;; it still completes a pending lui/auipc address.
                      (t (maybe-print-address rd imm)
                         (values "addi" (ops (x rd) (x rd) imm))))))
           (1 (let ((imm (signed (logior (ash (bit1 h 12) 5) (bits h 6 2)) 6)))
                (cond ((= rd 0) (values nil nil))
                      (t (when (/= imm 0) (maybe-print-address rd imm t))
                         (if (= imm 0)
                             (values "sext.w" (ops (x rd) (x rd)))
                             (values "addiw" (ops (x rd) (x rd) imm)))))))
           (2 (let ((imm (signed (logior (ash (bit1 h 12) 5) (bits h 6 2)) 6)))
                (values (if (= rd 0) "c.li" "li") (ops (x rd) imm))))
           (3 (cond ((= rd 2)
                     (let ((imm (signed (logior (ash (bit1 h 12) 9) (ash (bit1 h 6) 4)
                                                (ash (bit1 h 5) 6) (ash (bits h 4 3) 7)
                                                (ash (bit1 h 2) 5))
                                        10)))
                       (if (= imm 0) (values nil nil) (values "addi" (ops "sp" "sp" imm)))))
                    (t (let ((imm (signed (logior (ash (bit1 h 12) 5) (bits h 6 2)) 6)))
                         (cond ((= imm 0) (values nil nil))
                               ((= rd 0) (values "c.lui" (ops (x rd) (hex (logand imm #xfffff)))))
                               (t (note-hi-addr rd (ash imm 12))
                                  (values "lui" (ops (x rd) (hex (logand imm #xfffff))))))))))
           (4 (let ((kind (bits h 11 10)) (shamt (c-shamt h)))
                (case kind
                  (0 (if (= shamt 0)
                         (values "c.srli64" (xc rd3))
                         (values "srli" (ops (xc rd3) (xc rd3) (hex shamt)))))
                  (1 (if (= shamt 0)
                         (values "c.srai64" (xc rd3))
                         (values "srai" (ops (xc rd3) (xc rd3) (hex shamt)))))
                  (2 (values "andi" (ops (xc rd3) (xc rd3) (signed shamt 6))))
                  (3 (let ((sub (bits h 6 5)))
                       (if (= (bit1 h 12) 0)
                           (values (aref #("sub" "xor" "or" "and") sub)
                                   (ops (xc rd3) (xc rd3) (xc rs2-3)))
                           (case sub
                             (0 (values "subw" (ops (xc rd3) (xc rd3) (xc rs2-3))))
                             (1 (values "addw" (ops (xc rd3) (xc rd3) (xc rs2-3))))
                             (t (values nil nil)))))))))
           (5 (let ((imm (signed (logior (ash (bit1 h 12) 11) (ash (bit1 h 8) 10)
                                         (ash (bits h 10 9) 8) (ash (bit1 h 6) 7)
                                         (ash (bit1 h 7) 6) (ash (bit1 h 2) 5)
                                         (ash (bit1 h 11) 4) (ash (bits h 5 3) 1))
                                 12)))
                (values "j" (funcall tp (+ pos imm)))))
           ((6 7)
            (let ((imm (signed (logior (ash (bit1 h 12) 8) (ash (bits h 6 5) 6)
                                       (ash (bit1 h 2) 5) (ash (bits h 11 10) 3)
                                       (ash (bits h 4 3) 1))
                               9)))
              (values (if (= f3 6) "beqz" "bnez") (ops (xc rd3) (funcall tp (+ pos imm))))))
           (t (values nil nil))))
      (2 (case f3
           (0 (let ((shamt (c-shamt h)))
                (cond ((= shamt 0) (values "c.slli64" (x rd)))
                      ((= rd 0) (values "c.slli" (ops (x rd) (hex shamt))))
                      (t (values "slli" (ops (x rd) (x rd) (hex shamt)))))))
           ((1 3)
            (let ((uimm (logior (ash (bit1 h 12) 5) (ash (bits h 6 5) 3) (ash (bits h 4 2) 6))))
              (if (= f3 1)
                  (values "fld" (ops (f rd) (mem uimm "sp")))
                  (if (= rd 0) (values nil nil) (values "ld" (ops (x rd) (mem uimm "sp")))))))
           (2 (let ((uimm (logior (ash (bit1 h 12) 5) (ash (bits h 6 4) 2) (ash (bits h 3 2) 6))))
                (if (= rd 0) (values nil nil) (values "lw" (ops (x rd) (mem uimm "sp"))))))
           (4 (cond ((= (bit1 h 12) 0)
                     (cond ((and (= rs2 0) (= rd 0)) (values nil nil))
                           ((= rs2 0) (if (= rd 1) (values "ret" "") (values "jr" (x rd))))
                           ((= rd 0) (values "c.mv" (ops (x rd) (x rs2))))
                           (t (values "mv" (ops (x rd) (x rs2))))))
                    ((and (= rd 0) (= rs2 0)) (values "ebreak" ""))
                    ((= rs2 0) (values "jalr" (x rd)))
                    ((= rd 0) (values "c.add" (ops (x rd) (x rs2))))
                    (t (values "add" (ops (x rd) (x rd) (x rs2))))))
           ((5 7)
            (let ((uimm (logior (ash (bits h 12 10) 3) (ash (bits h 9 7) 6))))
              (if (= f3 5)
                  (values "fsd" (ops (f rs2) (mem uimm "sp")))
                  (values "sd" (ops (x rs2) (mem uimm "sp"))))))
           (6 (let ((uimm (logior (ash (bits h 12 9) 2) (ash (bits h 8 7) 6))))
                (values "sw" (ops (x rs2) (mem uimm "sp")))))
           (t (values nil nil))))
      (t (values nil nil)))))

;;; ------------------------------------------------------------------
;;; Driver

(defun decode-instruction (bytes pos &key (target-printer #'default-target-printer))
  "Decode the instruction at POS. Returns (VALUES MNEMONIC OPERANDS LENGTH).
MNEMONIC is NIL only when the bytes end before the encoding does; an encoding
the tables do not know decodes as objdump's `.insn LENGTH, 0xWORD`.
TARGET-PRINTER renders a relative branch destination given the absolute
offset of the target."
  (let ((len (instruction-length bytes pos)))
    (if (> (+ pos len) (length bytes))
        (values nil nil (- (length bytes) pos))
        (let ((word (le-word bytes pos len)))
          (setf *address-comment* nil)
          (multiple-value-bind (mnemonic operands)
              (case len
                (2 (decode-16 word pos target-printer))
                (4 (decode-32 word pos target-printer))
                (t (values nil nil)))
            (cond ((null mnemonic)
                   (values ".insn" (format nil "~D, 0x~(~v,'0X~)" len (* 2 len) word) len))
                  (*address-comment*
                   (values mnemonic (format nil "~A # ~A" operands (hex *address-comment*)) len))
                  (t (values mnemonic operands len))))))))

(defun default-target-printer (target)
  (hex target))

(defun hex-bytes (bytes pos len)
  (format nil "~{~(~2,'0X~)~^ ~}" (loop for i from pos below (+ pos len) collect (aref bytes i))))

(defun trailing-zeroes-skipped-p (bytes pos)
  "objdump omits a run of fewer than three zero bytes that reaches the end of
the input (its skip_zeroes_at_end), which is what a pool's padding looks like."
  (let ((run (loop for i from pos below (length bytes)
                   while (zerop (aref bytes i)) count t)))
    (and (plusp run) (= (+ pos run) (length bytes)) (< run 3))))

(defun format-objdump-lines (sequence &key (base 0))
  "One line per instruction in objdump's `mnemonic<TAB>operands` shape, with
branch targets printed as absolute hex offsets from BASE. For the oracle test."
  (let ((bytes (as-octets sequence)))
    (reset-address-state)
    (with-output-to-string (out)
      (loop with pos = 0
            while (and (< pos (length bytes)) (not (trailing-zeroes-skipped-p bytes pos)))
            do (multiple-value-bind (mnemonic ops len)
                   (decode-instruction bytes pos
                                       :target-printer (lambda (target) (hex (+ base target))))
                 (if mnemonic
                     (format out "~A~A~A~%" mnemonic (if (string= ops "") "" #\Tab) ops)
                     (format out ".byte~A~{0x~(~2,'0X~)~^,~}~%" #\Tab
                             (loop for i from pos below (+ pos len) collect (aref bytes i))))
                 (incf pos len))))))

(defun format-native-listing (sequence)
  "DISASSEMBLE's native section: `  +OFFSET:  BYTES   MNEMONIC OPERANDS`, with
relative branch destinations shown as +OFFSET into the same function."
  (let ((bytes (as-octets sequence)))
    (reset-address-state)
    (with-output-to-string (out)
      (loop with pos = 0
            while (< pos (length bytes))
            do (multiple-value-bind (mnemonic ops len)
                   (decode-instruction bytes pos
                                       :target-printer (lambda (target) (format nil "+~(~4,'0X~)" target)))
                 (format out "  +~(~4,'0X~):  ~12A " pos (hex-bytes bytes pos len))
                 (if mnemonic
                     (format out "~A~@[ ~A~]~%" mnemonic (if (string= ops "") nil ops))
                     (format out ".byte ~{0x~(~2,'0X~)~^, ~}~%"
                             (loop for i from pos below (+ pos len) collect (aref bytes i))))
                 (incf pos len))))))
