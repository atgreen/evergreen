;;;; In-process RISC-V (RV64GC) disassembler for DISASSEMBLE.
;;;;
;;;; The Rust side hands this file the native code of a T1/T2 function as a
;;;; list of octets and prints the string FORMAT-NATIVE-LISTING returns. The
;;;; decoding is pure byte arithmetic, so the same code is exercised on every
;;;; host by fixtures generated with GNU objdump (bliss-miro8.10). Output follows
;;;; binutils' default syntax -- ABI register names and the standard alias
;;;; forms (li, mv, ret, beqz, sext.w, ...) -- so a listing can be diffed
;;;; against `objdump -D -b binary -m riscv:rv64`.
;;;;
;;;; RISC-V encodes an instruction's length in its first halfword: low bits
;;;; other than 11 mean a 16-bit compressed instruction, 11 with bits 4:2 not
;;;; all set means 32 bits, and the longer encodings are reserved shapes that
;;;; objdump prints as `.insn N, 0x...`. Unknown encodings keep their
;;;; architectural length, so offsets never drift past them; a literal pool
;;;; after the code therefore decodes to harmless noise, exactly as objdump
;;;; shows it.

(defpackage #:egcl-disasm-riscv64
  (:use #:cl)
  (:export #:decode-instruction
           #:format-native-listing
           #:format-objdump-lines))

(in-package #:egcl-disasm-riscv64)

;;; ------------------------------------------------------------------
;;; Bit helpers

(defun bits (word hi lo)
  "Bits HI..LO of WORD, inclusive, as an unsigned integer."
  (ldb (byte (1+ (- hi lo)) lo) word))

(defun bit1 (word index)
  (ldb (byte 1 index) word))

(defun signed (value width)
  (if (logbitp (1- width) value) (- value (ash 1 width)) value))

(defun as-octets (sequence)
  (if (and (vectorp sequence) (not (stringp sequence)))
      sequence
      (coerce sequence '(vector (unsigned-byte 8)))))

(defun le-word (bytes pos len)
  "The little-endian integer in BYTES[POS .. POS+LEN)."
  (let ((value 0))
    (loop for i from (1- len) downto 0
          do (setf value (logior (ash value 8) (aref bytes (+ pos i)))))
    value))

;;; ------------------------------------------------------------------
;;; Registers

(defparameter *gpr-names*
  #("zero" "ra" "sp" "gp" "tp" "t0" "t1" "t2" "s0" "s1" "a0" "a1" "a2" "a3"
    "a4" "a5" "a6" "a7" "s2" "s3" "s4" "s5" "s6" "s7" "s8" "s9" "s10" "s11"
    "t3" "t4" "t5" "t6"))

(defparameter *fpr-names*
  #("ft0" "ft1" "ft2" "ft3" "ft4" "ft5" "ft6" "ft7" "fs0" "fs1" "fa0" "fa1"
    "fa2" "fa3" "fa4" "fa5" "fa6" "fa7" "fs2" "fs3" "fs4" "fs5" "fs6" "fs7"
    "fs8" "fs9" "fs10" "fs11" "ft8" "ft9" "ft10" "ft11"))

(defun x (n) (aref *gpr-names* n))
(defun f (n) (aref *fpr-names* n))

;; Compressed instructions name x8-x15 / f8-f15 with three bits.
(defun xc (n) (x (+ n 8)))
(defun fc (n) (f (+ n 8)))

